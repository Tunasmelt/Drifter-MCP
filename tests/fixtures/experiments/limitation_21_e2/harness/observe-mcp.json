{
  "mcpServers": {
    "orders": {
      "command": "REPO/.venv/Scripts/drifter.exe",
      "args": [
        "observe",
        "--config",
        "WORKSPACE/drifter.yaml",
        "--server",
        "orders"
      ],
      "env": {
        "DRIFTER_RUNS_DIR": "WORKSPACE/.drifter/runs",
        "DRIFTER_RAW_DIR": "WORKSPACE/.drifter/raw"
      }
    }
  }
}